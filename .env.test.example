# Variables para `npm test`. Copia este archivo como .env.test.
# Usa una base de datos SEPARADA: las pruebas borran sus tablas en cada ejecución.
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://taskapp:taskapp@localhost:5432/task_manager_test
DB_SSL=false
JWT_SECRET=secreto-solo-para-pruebas-0123456789abcdef
JWT_EXPIRES_IN=1h
# Costo bajo para que las pruebas sean rápidas. NO usar este valor en producción.
BCRYPT_SALT_ROUNDS=4
